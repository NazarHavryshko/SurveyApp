{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "sql-swagger-route": {
        "ClusterId": "sql-cluster",
        "Order": 1,
        "Match": {
          "Path": "/swagger/sql/swagger.json"
        },
        "Transforms": [
          { "PathPattern": "/swagger/v1/swagger.json" }
        ]
      },
      "nosql-swagger-route": {
        "ClusterId": "nosql-cluster",
        "Order": 1,
        "Match": {
          "Path": "/swagger/nosql/swagger.json"
        },
        "Transforms": [
          { "PathPattern": "/swagger/v1/swagger.json" }
        ]
      },
      "nosql-route": {
        "ClusterId": "nosql-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/{controller:regex(^(responses|analytics)$)}/{**catch-all}"
        }
      },
      "nosql-internal-diagrams-route": {
        "ClusterId": "nosql-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/internal/surveys/{**catch-all}"
        }
      },
      "sql-route": {
        "ClusterId": "sql-cluster",
        "Order": 3,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "sql-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "sql-service": {
            "Address": "http://sql_service:8080"
          }
        }
      },
      "nosql-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "nosql-service": {
            "Address": "http://nosql-service:5002"
          }
        }
      }
    }
  }
}